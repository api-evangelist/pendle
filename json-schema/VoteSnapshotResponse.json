{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoteSnapshotResponse",
  "type": "object",
  "properties": {
    "votes": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/VoteResponse"
      }
    },
    "totalPools": {
      "type": "number"
    },
    "totalVotes": {
      "type": "number"
