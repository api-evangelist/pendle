{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PointMetadataEntity",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Either \"multiplier\" or \"points-per-asset\"",
      "enum": [
        "multiplier",
        "points-per-asset"
      ]
    },
    "pendleAsset": {
      "type": "string",
      "description": "Either \"basic\" or \"lp\"",
      "enum": [
        "basic",
        "lp"
      ]
    },
    "externalDashboardURL": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "perDollarLp": {
      "type": "boolean"
    }
  },
  "required": [
    "key",
    "type",
    "pendleAsset",
    "externalDashboardURL",
    "value",
    "perDollarLp"
  ]
}