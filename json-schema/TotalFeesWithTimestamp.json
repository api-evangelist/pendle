{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TotalFeesWithTimestamp",
  "type": "object",
  "properties": {
    "time": {
      "format": "date-time",
      "type": "string",
      "description": "timestamp where total fee is being calculated"
    },
    "totalFees": {
      "type": "number",
      "description": "total fees at given timestamp"
    }
  },
  "required": [
    "time",
    "totalFees"
  ]
}