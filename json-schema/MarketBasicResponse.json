{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketBasicResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "chainId": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "expiry": {
      "format": "date-time",
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "chainId",
    "address",
    "symbol",
    "expiry",
    "name"
  ]
}