      "type": "string"
    },
    "psAmountFromTaker": {
      "type": "string"
    },
    "ysAmountToTaker": {
      "type": "string"
    },
    "ysAmountFromTaker": {
      "type": "string"
    },
    "fee": {
      "type": "string"
    },
